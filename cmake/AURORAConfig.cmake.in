@PACKAGE_INIT@

# If the user didn't specify COMPONENTS, default to 'aul'
if(NOT @CMAKE_PROJECT_NAME@_FIND_COMPONENTS)
    set(@CMAKE_PROJECT_NAME@_FIND_COMPONENTS aul)
endif()

# Check and load each requested component
foreach(comp ${@CMAKE_PROJECT_NAME@_FIND_COMPONENTS})
    set(_target_file "${CMAKE_CURRENT_LIST_DIR}/${comp}Targets.cmake")
    
    if(EXISTS "${_target_file}")
        include("${_target_file}")
        set(AURORA_${comp}_FOUND TRUE)
    else()
        set(@CMAKE_PROJECT_NAME@_FOUND FALSE)
        set(@CMAKE_PROJECT_NAME@_NOT_FOUND_MESSAGE "component '${comp}' was requested but not found.")
    endif()
endforeach()

check_required_components(@CMAKE_PROJECT_NAME@)
