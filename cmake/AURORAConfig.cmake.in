@PACKAGE_INIT@

# If the user didn't specify COMPONENTS, default to 'aul'
if(NOT AURORA_FIND_COMPONENTS)
    set(AURORA_FIND_COMPONENTS aul)
endif()

# Check and load each requested component
foreach(comp ${AURORA_FIND_COMPONENTS})
    set(_target_file "${CMAKE_CURRENT_LIST_DIR}/${comp}Targets.cmake")
    
    if(EXISTS "${_target_file}")
        include("${_target_file}")
        set(AURORA_${comp}_FOUND TRUE)
    else()
        set(AURORA_FOUND FALSE)
        set(AURORA_NOT_FOUND_MESSAGE "AURORA component '${comp}' was requested but not found.")
    endif()
endforeach()

check_required_components(AURORA)
